      "slug": "opreturn-text"
    },
    {
      "id": "SFS-23",
      "kind": "spam",
      "carry": "definition",
      "title": "OP_RETURN data",
      "from": "cesspool",
      "code": false,
      "schema": {
        "opreturn": "binary",
        "payload_bytes_max": 83,
        "not": "a named prefix or the 32-byte commitment"
      },
      "slug": "opreturn-data"
    },
    {
      "id": "SFS-24",
      "kind": "spam",
      "carry": "definition",
      "title": "Inscription envelope",
      "from": "gbt-rules flt:side-inscription",
      "code": false,
      "schema": {
        "envelope_bytes_min": 1,
        "pattern": "OP_FALSE OP_IF \u2026 ord"
      },
      "note": "On this chain OP_IF in a tapscript is already invalid. The row stays so the name is not confused with cat21.",
      "slug": "inscription"
    },
    {
      "id": "SFS-25",
      "kind": "spam",
      "carry": "definition",
      "title": "Heavy data",
      "from": "gbt-rules flt:side-data",
      "code": "rejectheavytapscript in spamcore.py",
      "schema": {
        "any": [
          {
            "opreturn_bytes_min": 84
          },
          {
            "largest_tapscript_bytes_min": 521
          }
        ]
      },
      "note": "The switch marks a revealed tapscript at least this many bytes. A large OP_RETURN is the data-carrier mark.",
      "slug": "data-heavy"
    },
    {
      "id": "SFS-26",
      "kind": "spam",
      "carry": "definition",
      "title": "Several OP_RETURNs",
      "from": "gbt-rules flt:side-op-return-stack",
      "code": "rejectopreturnstack in spamcore.py",
      "schema": {
        "opreturn_count_min": 2
      },
      "slug": "opreturn-stack"
    },
    {
      "id": "SFS-27",
      "kind": "spam",
      "carry": "definition",
      "title": "Dust output",
      "from": "gbt-rules flt:side-dust",
      "code": "dust_sat_per_kvb in spamcore.py",
      "schema": {
        "dust_outputs_min": 1,
        "dust_rate_sat_per_vb": 3
      },
      "note": "Does not match the Ark exit parent. A zero-value anchor on that parent is the whitelist, not dust.",
      "slug": "dust-output"
    },
    {
      "id": "SFS-28",
      "kind": "spam",
      "carry": "definition",
      "title": "Minimum fee",
