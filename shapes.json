{
  "catalog": "riptide-sidecar-shapes",
  "version": 1,
  "loaded_by_sidecar": false,
  "sources": [
    "https://cesspool.lol/guide/",
    "https://bitcoin-blake.github.io/gbt-rules/schema/"
  ],
  "transfer": {
    "listen": "the Bitcoin port plus 2",
    "handshake": [
      "whitelist",
      "spam",
      "both"
    ],
    "arrives_disabled": true,
    "local_enable_wins": true,
    "bitcoin_relay": false,
    "spam": "the shape object only",
    "whitelist_package": "the shape object, then the signed parent, then the child"
  },
  "shapes": [
    {
      "id": "WLS-1",
      "kind": "whitelist",
      "carry": "package",
      "title": "Ark exit",
      "from": "ours",
      "code": "parent only, in spamcore.py",
      "schema": {
        "parent": {
          "version": 3,
          "fee_sat": 0,
          "anchor": {
            "count": 1,
            "value_sat": 0,
            "script_hex": "51024e73"
          }
        },
        "child": {
          "spends": "the parent anchor",
          "pays": "the miner fee"
        }
      },
      "insert": {
        "parent": {
          "method": "sendrawtransaction",
          "ignore_rejects": [
            "min relay fee not met",
            "dust-nonanchor",
            "dust-nonzero",
            "dust"
          ]
        },
        "then": "the parent is in this mempool",
        "child": {
          "method": "sendrawtransaction"
        }
      },
      "note": "The package is what moves between sidecars. Enabling it inserts the pair here and leaves it unmarked. It does not go out on the Bitcoin port. The child is part of the package and is not itself a whitelist shape.",
      "slug": "ark-exit"
    },
    {
      "id": "WLS-2",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Package-paid",
      "from": "ours",
      "code": "whitelist_package_paid in spamcore.py",
      "schema": {
        "own_fee_below_line": true,
        "descendant_package_sat_vb_min": 1
      },
      "note": "A low-fee transaction whose descendant package already meets the fee line. Clears only the minimum-fee mark. Any other spam mark remains.",
      "slug": "package-paid"
    },
    {
      "id": "WLS-3",
      "kind": "whitelist",
      "carry": "definition",
      "title": "32-byte commitment",
      "from": "cesspool",
      "code": false,
      "schema": {
        "opreturn": {
          "count": 1,
          "payload_bytes": 32
        }
      },
      "note": "OpenTimestamps, proof-of-reserves, and RGB use this length. The length is the match, not the contents. Leave it unmarked if the node already accepted it. No extra send.",
      "slug": "commitment-32"
    },
    {
      "id": "WLS-4",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Empty runestone",
      "from": "cesspool",
      "code": false,
      "schema": {
        "opreturn": {
          "script_hex_prefix": "6a5d",
          "payload_bytes": 0
        }
      },
      "note": "OP_RETURN OP_13 and nothing after it. A real runestone, with bytes after OP_13, is spam.",
      "slug": "empty-runestone"
    },
    {
      "id": "WLS-5",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Empty OP_RETURN",
      "from": "cesspool",
      "code": false,
      "schema": {
        "opreturn": {
          "count": 1,
          "payload_bytes": 0
        }
      },
      "slug": "empty-opreturn"
    },
    {
      "id": "WLS-6",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Lightning anchor sweep",
      "from": "cesspool",
      "code": false,
      "schema": {
        "spends": "lightning anchor outputs",
        "only_output": "opreturn",
        "opreturn_payload_bytes_max": 3
      },
      "note": "Padding so a one-input sweep reaches the 65-byte minimum. Knots refuses a transaction whose only output is an OP_RETURN, so this stays off the public port. It is not an insert package.",
      "slug": "lightning-anchor-sweep"
    },
    {
      "id": "WLS-7",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Pay-to-anchor sweep",
      "from": "cesspool",
      "code": false,
      "schema": {
        "spends": "pay-to-anchor outputs",
        "only_output": "opreturn",
        "opreturn_payload_bytes_max": 4
      },
      "note": "Same class as the Lightning sweep. Not the Ark exit. The Ark exit is a version-3 parent plus a paying child, and that one is the package.",
      "slug": "p2a-sweep"
    },
    {
      "id": "WLS-8",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Dust sweep",
      "from": "cesspool",
      "code": false,
      "schema": {
        "only_output": "opreturn",
        "opreturn_payload_bytes_max": 4
      },
      "note": "More than 4 bytes in that only output is spam, not this row.",
      "slug": "dust-sweep"
    },
    {
      "id": "WLS-9",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Rootstock PowPeg flyover",
      "from": "cesspool",
      "code": false,
      "schema": {
        "witness": "the PowPeg script this chain has revealed since the fork",
        "keys": 13,
        "threshold_seen": "5 of 9",
        "prefix": "32 bytes dropped unused"
      },
      "note": "Any other script stays spam. The script is not checked against an address Rootstock publishes.",
      "slug": "powpeg-flyover"
    },
    {
      "id": "WLS-10",
      "kind": "whitelist",
      "carry": "definition",
      "title": "Consolidation",
      "from": "gbt-rules flt:side-sweep",
      "code": false,
      "schema": {
        "inputs_min": 25,
        "outputs_max": 3
      },
      "note": "Shrinks the coin set. Leave it unmarked. It is not a package and it does not get a fee credit yet.",
      "slug": "consolidation"
    },
    {
      "id": "SFS-1",
      "kind": "spam",
      "carry": "definition",
      "title": "CAT-21",
      "from": "knots -rejectparasites",
      "code": "locktime 21 in spamcore.py",
      "schema": {
        "locktime": 21
      },
      "note": "This is the whole Knots check. The schema page only names the option and points at inscriptions. Inscriptions are a different row.",
      "slug": "cat21"
    },
    {
      "id": "SFS-2",
      "kind": "spam",
      "carry": "definition",
      "title": "Runestone",
      "from": "cesspool",
      "code": "OP_RETURN OP_13 in spamcore.py",
      "schema": {
        "opreturn": {
          "next_opcode": "OP_13",
          "payload_bytes_min": 1
        }
      },
      "note": "Knots refuses this with -rejecttokens, so a strict node never hands it to the sidecar.",
      "slug": "runestone"
    },
    {
      "id": "SFS-3",
      "kind": "spam",
      "carry": "definition",
      "title": "Counterparty",
      "from": "cesspool",
      "code": "plaintext CNTRPRTY prefix only",
      "schema": {
        "opreturn": {
          "decrypt": "RC4 under the first input txid",
          "then_prefix": "CNTRPRTY"
        }
      },
      "note": "The live check looks for the plaintext prefix. The chain form is encrypted, and Knots decrypts it.",
      "slug": "counterparty"
    },
    {
      "id": "SFS-4",
      "kind": "spam",
      "carry": "definition",
      "title": "OLGA stamps",
      "from": "cesspool",
      "code": "stamp: prefix in spamcore.py",
      "schema": {
        "tag": "stamp:",
        "where": "a length prefix, then the tag, then consecutive P2WSH output hashes"
      },
      "slug": "stamps"
    },
    {
      "id": "SFS-5",
      "kind": "spam",
      "carry": "definition",
      "title": "Fake multisig keys",
      "from": "cesspool",
      "code": "more than 10 pubkey pushes in spamcore.py",
      "schema": {
        "unsigned_keys_min": 11,
        "per": "script"
      },
      "note": "Plumb counts a key as signed only when a signature in the spend verifies against it. This catalog does not do that check yet. A 2-of-3 and an 11-of-15 federation spend are the cases that must stay out of this row.",
      "slug": "fake-multisig"
    },
    {
      "id": "SFS-6",
      "kind": "spam",
      "carry": "definition",
      "title": "Dead branch",
      "from": "cesspool",
      "code": "OP_FALSE OP_IF and OP_1 OP_NOTIF in spamcore.py",
      "schema": {
        "patterns": [
          "OP_FALSE OP_IF",
          "OP_1 OP_NOTIF"
        ]
      },
      "note": "A branch decided by a signature or a witness item is not this row.",
      "slug": "dead-branch"
    },
    {
      "id": "SFS-7",
      "kind": "spam",
      "carry": "definition",
      "title": "Bare data envelope",
      "from": "cesspool",
      "code": "pushes ending in OP_DROP or OP_2DROP in spamcore.py",
      "schema": {
        "script": "only pushes, then OP_DROP or OP_2DROP"
      },
      "slug": "bare-envelope"
    },
    {
      "id": "SFS-8",
      "kind": "spam",
      "carry": "definition",
      "title": "Bare inscription",
      "from": "cesspool",
      "code": false,
      "schema": {
        "script": "pushes, including the ord tag, dropped with OP_2DROP",
        "not": "wrapped in OP_FALSE OP_IF"
      },
      "slug": "bare-inscription"
    },
    {
      "id": "SFS-9",
      "kind": "spam",
      "carry": "definition",
      "title": "Unnamed witness data",
      "from": "cesspool",
      "code": false,
      "schema": {
        "input_data": "counted by policy, and not one of the named witness rows"
      },
      "note": "A holding row. It is not a check until the bytes have a name.",
      "slug": "witness-unnamed"
    },
    {
      "id": "SFS-10",
      "kind": "spam",
      "carry": "definition",
      "title": "Swap memo",
      "from": "cesspool",
      "code": false,
      "schema": {
        "opreturn_prefixes": [
          "=:",
          "to:"
        ],
        "examples": [
          "=:BTC.BTC:",
          "to:USDT(BSC):"
        ]
      },
      "note": "Fits an 83-byte OP_RETURN, so stock Knots relays it.",
      "slug": "swap-memo"
    },
    {
      "id": "SFS-11",
      "kind": "spam",
      "carry": "definition",
      "title": "JSON token message",
      "from": "cesspool",
