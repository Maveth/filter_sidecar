      "code": "minfeerate_sat_vb in spamcore.py",
      "schema": {
        "mark_below_sat_vb": null
      },
      "note": "Mark a transaction under this fee so the node leaves it out of the block. It stays in the mempool.",
      "slug": "min-fee"
    },
    {
      "id": "SFS-29",
      "kind": "spam",
      "carry": "definition",
      "title": "Dust spray",
      "from": "gbt-rules flt:side-dust-spray",
      "code": "rejectdustspray in spamcore.py",
      "schema": {
        "outputs_under_1000_sat_min": 10
      },
      "note": "Many outputs above zero and under a sat line. A zero output is an anchor, not spray.",
      "slug": "dust-spray"
    },
    {
      "id": "SFS-30",
      "kind": "spam",
      "carry": "definition",
      "title": "Fan-out",
      "from": "gbt-rules flt:side-fan-out",
      "code": "rejectfanout in spamcore.py",
      "schema": {
        "kept_outputs_min": 25,
        "inputs_max": 2
      },
      "note": "One or two inputs paying many outputs that stay in the UTXO set. OP_RETURN does not count. A coinjoin has too many inputs.",
      "slug": "fan-out"
    },
    {
      "id": "SFS-31",
      "kind": "spam",
      "carry": "definition",
      "title": "Many signatures",
      "from": "gbt-rules flt:side-many-sigs",
      "code": false,
      "schema": {
        "extra_signature_checks_min": 100
      },
      "slug": "many-sigs"
    },
    {
      "id": "opreturn-marker",
